<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= site.seo.titre %></title>
<meta name="description" content="<%= site.seo.description %>">
<meta name="theme-color" content="#1B3A6B">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Figtree:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="/css/style.css">
<meta property="og:title" content="<%= site.seo.titre %>">
<meta property="og:description" content="<%= site.seo.description %>">
<meta property="og:type" content="website">
<meta property="og:locale" content="fr_MA">
<meta property="og:url" content="<%= site.url %>/">
<meta property="og:site_name" content="<%= site.nom %>">
<meta property="og:image" content="<%= site.url %>/images/partage.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="<%= site.url %>/images/partage.jpg">
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": site.nom,
  "description": site.seo.description,
  "telephone": site.telephones[0].e164,
  "email": site.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Lot. Al Ward, Rue 22, Imm 4, " + site.quartier,
    "addressLocality": site.ville,
    "addressCountry": "MA"
  },
  "areaServed": "Grand Casablanca",
  "foundingDate": String(site.anneeCreation),
  "openingHours": "Mo-Su 00:00-24:00",
  "founder": { "@type": "Person", "name": site.gerant }
}, null, 2) %>
</script>
