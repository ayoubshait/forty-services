<div class="conteneur wallet-grille">
    <div class="wallet-texte">
      <div class="tete-section">
        <span class="sur-titre">Carte interactive</span>
        <<%= niveau %>>Votre contact Forty Services, toujours à portée de main.</<%= niveau %>>
        <p>Retrouvez nos coordonnées et accédez à notre site depuis votre téléphone. Ajoutez notre carte à Apple Wallet ou Google Wallet.</p>
      </div>
    </div>

    <div class="wallet-droite">
      <div class="carte3d" data-carte3d>
        <div class="carte3d-scene">
          <div class="carte3d-corps">
            <!-- Recto : logo en relief -->
            <div class="carte3d-face carte3d-recto">
              <img class="recto-symbole" src="/images/wallet/symbole-relief.svg" alt="" width="170" height="175">
              <div class="recto-texte">
                <span class="recto-nom">FORTY<br>SERVICES</span>
                <span class="recto-forme">S.A.R.L</span>
              </div>
              <p class="recto-services">Surveillance · Gardiennage · Nettoyage</p>
            </div>
            <!-- Verso : coordonnées -->
            <div class="carte3d-face carte3d-verso">
              <div class="verso-texte">
                <strong class="verso-nom">Mustapha SHAIT</strong>
                <span class="verso-role">Gérant</span>
                <ul class="verso-liens">
                  <li><a href="tel:+212611624718">+212 611 62 47 18</a></li>
                  <li><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
                  <li><a href="<%= site.url %>/">fortyservices.ma</a></li>
                </ul>
              </div>
              <div class="verso-scan">
                <img class="verso-qr" src="/images/wallet/qr.svg" alt="QR code vers fortyservices.ma" width="110" height="110">
                <span class="verso-scan-texte">Scanner pour découvrir nos services</span>
              </div>
            </div>
          </div>
        </div>
        <button type="button" class="carte3d-bouton" aria-pressed="false" hidden>Retourner la carte</button>
      </div>

      <div class="wallet-actions">
        <% if (site.carteNumerique.apple) { %>
        <a class="wallet-badge" href="<%= site.carteNumerique.apple %>" aria-label="Ajouter la carte Forty Services à l'app Cartes Apple">
          <img src="/images/wallet/ajouter-cartes-apple-fr.svg" alt="Ajouter à l'app Cartes Apple" width="168" height="56">
        </a>
        <% } %>
        <% if (site.carteNumerique.google) { %>
        <a class="wallet-badge" href="<%= site.carteNumerique.google %>" rel="noopener" aria-label="Ajouter la carte Forty Services à Google Wallet">
          <img src="/images/wallet/ajouter-google-wallet-fr.svg" alt="Ajouter à Google Wallet" width="203" height="56">
        </a>
        <% } %>
        <a class="wallet-contact" href="/wallet/forty-services.vcf" download="forty-services.vcf">
          <%- include('icones', { icone: 'personne', taille: 20, epais: 2 }) %>
          Enregistrer le contact
        </a>
      </div>
      <p class="wallet-legende">L'animation est disponible sur le site. L'affichage dans Wallet est différent.</p>
    </div>
  </div>
<script src="/js/carte3d.js?v=<%= site.version %>" defer></script>
