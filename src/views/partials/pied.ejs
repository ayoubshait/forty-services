<footer>
  <div class="conteneur">
    <div class="pied-haut">
      <div>
        <div class="pied-marque">
          <%- include('marque', { largeur: 26, couleurTrait: '#FFFFFF' }) %>
          <span class="nom">FORTY<br><span>SERVICES</span></span>
        </div>
        <p>Depuis <%= site.anneeCreation %> : gardiennage, surveillance et nettoyage professionnel au Maroc.</p>
      </div>
      <div>
        <p class="pied-titre">Services</p>
        <ul>
          <% site.services.forEach(function (service) { %>
          <li><a href="/<%= service.slug %>"><%= service.titre %></a></li>
          <% }); %>
        </ul>
      </div>
      <div>
        <p class="pied-titre">Contact</p>
        <ul>
          <% site.telephones.forEach(function (tel) { %>
          <li><a href="tel:<%= tel.e164 %>"><%= tel.affiche %></a></li>
          <% }); %>
          <li><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
          <li><%= site.adresse %></li>
        </ul>
      </div>
    </div>
    <div class="pied-bas">
      <span>© <%= new Date().getFullYear() %> <%= site.nom %><%= site.formeJuridique ? " " + site.formeJuridique : "" %>, <%= site.ville %></span>
      <span>Disponibles <%= site.disponibilite %></span>
      <% var legal = []; if (site.infosLegales.ice) legal.push('ICE : ' + site.infosLegales.ice); if (site.infosLegales.rc) legal.push('RC : ' + site.infosLegales.rc); if (site.infosLegales.patente) legal.push('Patente : ' + site.infosLegales.patente); %>
      <% if (legal.length) { %><span><%= legal.join(' · ') %></span><% } %>
      <a href="/mentions-legales">Mentions légales</a>
    </div>
  </div>
</footer>

<% /* Sur une page de service, le devis est prérempli avec ce service ; ailleurs, message général */
   var lienWa = locals.lienDevis || ('https://wa.me/' + site.whatsapp + '?text=' + encodeURIComponent(site.whatsappMessage)); %>
<a class="wa-flottant" href="<%= lienWa %>" aria-label="Nous contacter sur WhatsApp">
  <%- include('whatsapp-icone', { taille: 30 }) %>
</a>

<!-- Retour en haut : apparaît en bas de page -->
<button type="button" class="haut-page" aria-label="Revenir en haut de la page" hidden>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
</button>

<!-- Barre d'action mobile : appel + WhatsApp toujours sous le pouce -->
<div class="barre-mobile">
  <a class="bm-appel" href="tel:<%= site.telephones[0].e164 %>">
    <%- include('icones', { icone: 'telephone', taille: 19, stroke: 'currentColor', epais: 2 }) %>
    Appeler
  </a>
  <a class="bm-wa" href="<%= lienWa %>">
    <%- include('whatsapp-icone', { taille: 19 }) %>
    Demander un devis<span class="sr-only"> par WhatsApp</span>
  </a>
</div>

<script src="/js/main.js?v=<%= site.version %>"></script>
