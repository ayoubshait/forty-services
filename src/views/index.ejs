<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/tete') %>
</head>
<body>

<%- include('partials/entete') %>

<!-- ══════════════ HÉROS ══════════════ -->
<div class="heros" id="accueil">
  <!-- Scène 3D plein écran : le site client en miniature, un métier = une scène -->
  <div class="scene-vue">
    <canvas id="scene3d" class="scene-canvas" aria-hidden="true"></canvas>
  </div>

  <div class="conteneur heros-grille">
    <div class="heros-texte">
      <h1>Gardiennage et nettoyage professionnel <span>à <%= site.ville %> et ses environs</span></h1>
      <p class="heros-accroche">Protégez vos sites. Prenez soin de vos&nbsp;locaux.</p>
      <p class="heros-intro">Surveillance, gardiennage et nettoyage : des prestations adaptées à votre site, avec des équipes encadrées et un interlocuteur dédié.</p>
      <div class="heros-actions">
        <a class="btn btn-wa" href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent(site.whatsappMessage) %>">
          <%- include('partials/whatsapp-icone', { taille: 19 }) %>
          Demander un devis
        </a>
        <a class="btn btn-appel-clair" href="tel:<%= site.telephones[0].e164 %>">
          <%- include('partials/icones', { icone: 'telephone', taille: 18, stroke: 'currentColor', epais: 2 }) %>
          <%= site.telephones[0].affiche %>
        </a>
      </div>
    </div>
  </div>

  <!-- Panneau de contrôle : choix du métier, fiche courte, devis -->
  <div class="conteneur heros-panneau">
    <aside class="scene-cadre" aria-label="Nos prestations">
      <div class="scene-choix" role="group" aria-label="Choisir une prestation">
        <% site.services.forEach(function (service, i) { %>
        <button type="button" class="choix<%= i === 0 ? ' actif' : '' %>" aria-pressed="<%= i === 0 %>" data-titre="<%= service.titre %>" data-desc="<%= service.courte %>" data-wa="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent('Bonjour, je souhaite un devis pour : ' + service.titre + '.') %>">
          <%- include('partials/icones', { icone: service.icone, taille: 18, epais: 2 }) %>
          <span><%= service.court %></span>
        </button>
        <% }); %>
      </div>
      <div class="scene-fiche" aria-live="polite">
        <div class="sf-texte">
          <span class="sf-titre"><%= site.services[0].titre %></span>
          <p class="sf-desc"><%= site.services[0].courte %></p>
        </div>
        <a class="sf-cta" href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent('Bonjour, je souhaite un devis pour : ' + site.services[0].titre + '.') %>">
          <%- include('partials/whatsapp-icone', { taille: 17 }) %>
          Demander un devis
        </a>
      </div>
    </aside>
  </div>

  <!-- Réassurance sur une ligne -->
  <div class="conteneur heros-bandeau">
    <ul class="heros-reassurance">
      <li>
        <%- include('partials/icones', { icone: 'coche', taille: 16, epais: 2.5 }) %>
        Depuis <%= site.anneeCreation %>
      </li>
      <li>
        <%- include('partials/icones', { icone: 'coche', taille: 16, epais: 2.5 }) %>
        Dirigeant : <%= site.experienceMetier %> ans d'expérience
      </li>
      <li>
        <%- include('partials/icones', { icone: 'coche', taille: 16, epais: 2.5 }) %>
        24&nbsp;h/24 · 7&nbsp;j/7
      </li>
      <li>
        <%- include('partials/icones', { icone: 'coche', taille: 16, epais: 2.5 }) %>
        Devis gratuit sous <%- site.delaiDevis.replace(" ", "&nbsp;") %>
      </li>
    </ul>
  </div>

  <!-- Vague signature : marine vers blanc -->
  <svg class="vague" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" style="background:#1B3A6B;">
    <path d="M0,48 C240,88 480,8 720,34 C960,60 1200,76 1440,26 L1440,90 L0,90 Z" fill="#FFFFFF"/>
    <path d="M0,40 C240,80 480,0 720,26 C960,52 1200,68 1440,18" fill="none" stroke="#29A8DF" stroke-width="3" opacity="0.75"/>
  </svg>
</div>

<!-- ══════════════ SERVICES ══════════════ -->
<section id="services">
  <div class="conteneur">
    <div class="tete-section">
      <span class="sur-titre">Nos services</span>
      <h2>Des prestations adaptées à votre site et à votre activité</h2>
      <p>Prévenir les risques, entretenir vos espaces, préparer la livraison de vos locaux : choisissez la prestation qui répond à vos besoins.</p>
    </div>

    <div class="grille-services">
      <% site.services.forEach(function (service, i) { %>
      <article class="carte revele"<% if (i > 0) { %> style="--delai:<%= (i * 0.08).toFixed(2) %>s;"<% } %>>
        <div class="carte-tete">
          <div class="icone">
            <%- include('partials/icones', { icone: service.icone, taille: 28 }) %>
          </div>
          <h3><%= service.titre %></h3>
        </div>
        <p><%= service.description %></p>
        <a class="lien-wa" href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent('Bonjour, je souhaite un devis pour : ' + service.titre + '.') %>">
          <%- include('partials/whatsapp-icone', { taille: 15, fill: 'currentColor' }) %>
          Demander un devis
        </a>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- ══════════════ ÉQUIPE ══════════════ -->
<section id="equipe" class="fond-gris">
  <div class="conteneur equipe-grille">
    <figure class="equipe-photo revele">
      <img src="<%= site.photos.equipe.src %>" alt="<%= site.photos.equipe.alt %>" loading="lazy">
    </figure>
    <div class="equipe-texte">
      <span class="sur-titre">Notre équipe</span>
      <h2>Une équipe de proximité pour vos sites</h2>
      <% site.presentation.forEach(function (paragraphe) { %>
      <p><%= paragraphe %></p>
      <% }); %>
      <div class="equipe-stats">
        <div>
          <strong data-compte="<%= site.anneeCreation %>"><%= site.anneeCreation %></strong>
          <span>création de l'entreprise</span>
        </div>
        <div>
          <strong data-compte="<%= site.experienceMetier %>" data-suffixe=" ans"><%= site.experienceMetier %> ans</strong>
          <span>d'expérience</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════ ENGAGEMENTS ══════════════ -->
<section id="engagements">
  <div class="conteneur">
    <div class="tete-section">
      <span class="sur-titre">Nos engagements</span>
      <h2>Des équipes encadrées. Un suivi clair.</h2>
    </div>

    <div class="grille-engagements">
      <% site.engagements.forEach(function (engagement, i) { %>
      <div class="engagement revele"<% if (i > 0) { %> style="--delai:<%= (i * 0.08).toFixed(2) %>s;"<% } %>>
        <%- include('partials/icones', { icone: engagement.icone, taille: 27 }) %>
        <div>
          <h3><%= engagement.titre %></h3>
          <p><%= engagement.description %></p>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ══════════════ RÉFÉRENCES ══════════════ -->
<section id="references" class="fond-gris">
  <div class="conteneur">
    <div class="tete-section">
      <span class="sur-titre">Nos références</span>
      <h2>Ils nous confient la surveillance ou l'entretien de leurs sites</h2>
      <p>Usines textiles, hôtels, résidences et institutions : des clients de secteurs variés nous ont confié leurs sites.</p>
    </div>

    <ul class="grille-ref-cartes">
      <% site.referencesPhares.forEach(function (client) { %>
      <li class="ref-carte revele">
        <% if (client.logo) { %>
        <span class="ref-logo-zone ref-logo-zone--<%= client.logoFond === 'sombre' ? 'sombre' : 'clair' %>"><img src="<%= client.logo %>" alt="Logo <%= client.nom %>" loading="lazy"></span>
        <h3 class="ref-nom"><%= client.nom %></h3>
        <% } else { %>
        <div class="ref-wordmark-zone"><h3 class="ref-wordmark"><%= client.nom %></h3></div>
        <% } %>
        <p class="ref-prestations"><span class="sr-only">Prestations : </span><%= client.prestations.join(' · ') %></p>
      </li>
      <% }); %>
    </ul>

    <p class="ref-autres-titre">Autres références</p>
    <ul class="grille-references">
      <% site.references.forEach(function (client) { %>
      <% if (client.logo) { %>
      <li class="ref-logo"><img src="<%= client.logo %>" alt="Logo <%= client.nom %>" loading="lazy"></li>
      <% } else { %>
      <li><%= client.nom %></li>
      <% } %>
      <% }); %>
    </ul>
  </div>
</section>

<!-- ══════════════ PROCESSUS ══════════════ -->
<section id="deroulement">
  <div class="conteneur">
    <div class="tete-section">
      <span class="sur-titre">Notre processus</span>
      <h2>De votre besoin à l'intervention : quatre étapes claires</h2>
    </div>

    <ol class="grille-etapes">
      <% site.etapes.forEach(function (etape, i) { %>
      <li class="etape revele"<% if (i > 0) { %> style="--delai:<%= (i * 0.1).toFixed(2) %>s;"<% } %>>
        <span class="numero"><%= i + 1 %></span>
        <div>
          <span class="etape-icone"><%- include('partials/icones', { icone: etape.icone, taille: 26, epais: 1.8 }) %></span>
          <h3><%= etape.titre %></h3>
          <p><%= etape.description %></p>
        </div>
      </li>
      <% }); %>
    </ol>
  </div>
</section>

<!-- ══════════════ QUESTIONS FRÉQUENTES ══════════════ -->
<section id="faq" class="fond-gris">
  <div class="conteneur">
    <div class="tete-section">
      <span class="sur-titre">FAQ</span>
      <h2>Vos questions sur le gardiennage et le nettoyage</h2>
    </div>
    <div class="faq">
      <% site.faq.forEach(function (item) { %>
      <details>
        <summary><%= item.q %></summary>
        <p><%= item.r %></p>
      </details>
      <% }); %>
    </div>
  </div>
</section>

<!-- ══════════════ CONTACT ══════════════ -->
<section class="contact" id="contact">
  <div class="conteneur">
    <div class="contact-grille">
      <div>
        <div class="tete-section">
          <span class="sur-titre">Contact</span>
          <h2>Votre site a ses exigences. Parlons-en.</h2>
          <p>Vous recherchez une prestation de surveillance, de gardiennage ou de nettoyage à <%= site.zone %> ? Précisez votre besoin : nous étudierons avec vous l'organisation adaptée à votre site.</p>
          <p><%= site.zoneAutresVilles %></p>
        </div>

        <div class="contact-lignes">
          <div>
            <%- include('partials/icones', { icone: 'personne', taille: 19, epais: 2 }) %>
            <span><span class="etiquette">Votre interlocuteur</span><%= site.gerant %>, gérant : <%= site.experienceMetier %> ans d'expérience en surveillance</span>
          </div>
          <div>
            <%- include('partials/icones', { icone: 'telephone', taille: 19, epais: 2 }) %>
            <span><span class="etiquette">Téléphone</span>
              <% site.telephones.forEach(function (tel, i) { %><a href="tel:<%= tel.e164 %>"><%= tel.affiche %></a><%= i < site.telephones.length - 1 ? ' · ' : '' %><% }); %>
            </span>
          </div>
          <div>
            <%- include('partials/icones', { icone: 'email', taille: 19, epais: 2 }) %>
            <span><span class="etiquette">E-mail</span><a href="mailto:<%= site.email %>?subject=Demande%20de%20devis"><%= site.email %></a></span>
          </div>
          <div>
            <%- include('partials/icones', { icone: 'lieu', taille: 19, epais: 2 }) %>
            <span><span class="etiquette">Adresse</span><%= site.adresse %></span>
          </div>
          <div>
            <%- include('partials/icones', { icone: 'horloge', taille: 19, epais: 2 }) %>
            <span><span class="etiquette">Disponibilité</span><%= site.disponibilite %></span>
          </div>
          <% if (site.horairesContact) { %>
          <div>
            <%- include('partials/icones', { icone: 'telephone', taille: 19, epais: 2 }) %>
            <span><span class="etiquette">Horaires de contact</span><%= site.horairesContact %></span>
          </div>
          <% } %>
        </div>
      </div>

      <div class="panneau-devis revele">
        <h3>Devis gratuit sous <%- site.delaiDevis.replace(" ", "&nbsp;") %></h3>
        <p>Sans engagement. Le délai court à partir de la réception des informations nécessaires.</p>
        <a class="btn btn-wa-panneau" href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent(site.whatsappMessage) %>">
          <%- include('partials/whatsapp-icone', { taille: 20 }) %>
          Demander un devis
        </a>
        <a class="btn btn-appel" href="tel:<%= site.telephones[0].e164 %>">
          <%- include('partials/icones', { icone: 'telephone', taille: 18, stroke: 'currentColor', epais: 2 }) %>
          <%= site.telephones[0].affiche %>
        </a>
        <a class="btn btn-contour" href="mailto:<%= site.email %>?subject=Demande%20de%20devis">
          <%- include('partials/icones', { icone: 'email', taille: 18, stroke: 'currentColor', epais: 2 }) %>
          Écrire un e-mail
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/pied') %>

</body>
</html>
